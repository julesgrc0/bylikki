model Session {
  id String @id @default(uuid(7))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       SessionType @default(DEFAULT)
  active     Boolean     @default(true)
  secretHash String      @unique

  revokedAt     DateTime?
  revokedReason SessionRevokedReason?

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  ipHash         String?
  userAgentLabel String?

  @@index([userId, type, active])
  @@index([expiresAt])
}

model EmailOTP {
  id String @id @default(uuid(7))

  email    String
  codeHash String

  expiresAt  DateTime
  consumedAt DateTime?

  attempts Int @default(0)

  ipHash String?

  createdAt DateTime @default(now())

  @@index([email, consumedAt])
  @@index([expiresAt])
  @@index([ipHash, createdAt])
}

model RevokedToken {
  jti String @id

  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

/// Compteur a fenetre fixe : la limitation doit survivre au redemarrage et
/// etre partagee entre instances, ce qu'une carte en memoire ne permet pas.
model RateLimit {
  id String @id @default(uuid(7))

  bucket      String
  subject     String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([bucket, subject, windowStart])
  @@index([windowStart])
}
