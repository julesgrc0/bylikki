model Review {
  id String @id @default(uuid(7))

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Prenom affiche a cote de l'avis, saisi par l'auteur
  authorName String

  rating Int
  title  String?
  body   String

  /// Notes par critere, facultatives : elles affinent la note globale sans
  /// alourdir le formulaire pour celles qui veulent aller vite
  qualityRating  Int?
  accuracyRating Int?

  /// Reponse publique de la boutique, affichee sous l'avis
  replyBody String?
  repliedAt DateTime?

  /// Compteur denormalise des votes utiles, comme la note moyenne du produit
  helpfulCount Int          @default(0)
  votes        ReviewVote[]

  photos ReviewPhoto[]

  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([productId, status, helpfulCount])
  @@index([productId, status, rating])
  @@index([userId])
}

/// Un vote « utile » par personne et par avis. Le compteur denormalise sur
/// Review evite de compter les lignes a chaque affichage de fiche.
model ReviewVote {
  id String @id @default(uuid(7))

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([userId])
}

model ReviewPhoto {
  id String @id @default(uuid(7))

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  url      String
  width    Int
  height   Int
  position Int    @default(0)

  createdAt DateTime @default(now())

  @@index([reviewId, position])
}
