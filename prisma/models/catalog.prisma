model Category {
  id String @id @default(uuid(7))

  slug        String  @unique
  name        String
  description String?
  position    Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[] @relation("ProductCategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, position])
}

/// Definition d'un critere produit (taille, couleur, matiere, longueur...).
/// Ajouter un nouveau critere se fait en inserant une ligne, sans migration.
model Attribute {
  id String @id @default(uuid(7))

  key      String        @unique
  label    String
  kind     AttributeKind @default(SELECT)
  unit     String?
  position Int           @default(0)

  /// Expose comme facette dans la recherche avancee
  filterable  Boolean @default(true)
  /// Utilisable pour composer les variantes d'un produit
  variantAxis Boolean @default(false)

  values AttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filterable, position])
}

model AttributeValue {
  id String @id @default(uuid(7))

  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  value    String
  label    String
  hexColor String?
  position Int     @default(0)

  products ProductAttributeValue[]
  variants VariantAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId, position])
}

model Product {
  id String @id @default(uuid(7))

  slug        String        @unique
  name        String
  summary     String?
  description String
  story       String?
  badge       String?
  status      ProductStatus @default(DRAFT)

  basePriceCents Int
  currency       String @default("EUR")

  handmade Boolean @default(true)
  featured Boolean @default(false)

  /// Champ denormalise (minuscules, sans accents) alimente a l'ecriture pour la recherche plein texte
  searchText String @default("")

  ratingAverage Float @default(0)
  reviewCount   Int   @default(0)

  categories      Category[]              @relation("ProductCategories")
  wishlistedBy    WishlistItem[]
  images          ProductImage[]
  variants        ProductVariant[]
  attributeValues ProductAttributeValue[]
  customizations  CustomizationOption[]
  reviews         Review[]
  orderItems      OrderItem[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([status, featured])
  @@index([status, basePriceCents])
}

model ProductImage {
  id String @id @default(uuid(7))

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  alt      String @default("")
  position Int    @default(0)

  @@index([productId, position])
}

/// Facettes du produit : sert au filtrage et a l'affichage des caracteristiques
model ProductAttributeValue {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
}

model ProductVariant {
  id String @id @default(uuid(7))

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku                 String  @unique
  label               String
  priceCents          Int
  compareAtPriceCents Int?
  stock               Int     @default(0)
  available           Boolean @default(true)
  position            Int     @default(0)

  attributeValues VariantAttributeValue[]
  orderItems      OrderItem[]
  restockAlerts   RestockAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, position])
}

/// Combinaison de valeurs qui definit une variante (taille x couleur x matiere...)
model VariantAttributeValue {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

model CustomizationOption {
  id String @id @default(uuid(7))

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  key             String
  label           String
  helpText        String?
  kind            CustomizationKind @default(TEXT)
  required        Boolean           @default(false)
  maxLength       Int?
  priceDeltaCents Int               @default(0)
  position        Int               @default(0)

  choices CustomizationChoice[]

  @@unique([productId, key])
  @@index([productId, position])
}

model CustomizationChoice {
  id String @id @default(uuid(7))

  optionId String
  option   CustomizationOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  value           String
  label           String
  hexColor        String?
  priceDeltaCents Int     @default(0)
  position        Int     @default(0)

  @@unique([optionId, value])
  @@index([optionId, position])
}
