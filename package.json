{
	"name": "bylikki",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"prepare": "run-p db:generate sv:prepare",
		"dev": "run-s prepare sv:dev",
		"build": "run-s prepare sv:build",
		"format": "prettier --write .",
		"lint": "eslint . --fix",
		"all": "run-s prepare format lint sv:check sv:test",
		"sv:dev": "vite dev --host --port 3000",
		"sv:build": "vite build",
		"sv:prepare": "svelte-kit sync",
		"sv:check": "svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "prisma generate --schema=./prisma",
		"db:view": "prisma studio",
		"db:push": "prisma db push --schema=./prisma --accept-data-loss",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"sv:test": "vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
