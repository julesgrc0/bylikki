# Adresse publique du site, utilisee dans les e-mails et les liens absolus
PUBLIC_ORIGIN='https://bylikki.fr'
PUBLIC_NAME='Bylikki'

# Base de donnees PostgreSQL
PRISMA_DATABASE_URL=''

# Secrets applicatifs : 32 octets aleatoires chacun (openssl rand -base64 32)
# AUTH_SECRET signe les jetons de session, les empreintes d'IP et le cookie
# d'e-mail en attente. OTP_PEPPER poivre les codes a usage unique.
AUTH_SECRET=''
OTP_PEPPER=''

# Envoi des e-mails transactionnels
SMTP_HOST=''
SMTP_PORT='587'
SMTP_SECURE='false'
SMTP_USER=''
SMTP_PASSWORD=''
SMTP_FROM='Bylikki <bonjour@bylikki.fr>'

# Paiement
STRIPE_SECRET_KEY=''
STRIPE_WEBHOOK_SECRET=''

# Stockage des images (avis, avatars, photos produit)
BLOB_READ_WRITE_TOKEN=''
BLOB_STORE_ID=''

# Jeton de la tache planifiee de purge (Vercel Cron le pose automatiquement)
CRON_SECRET=''

# Destinataire des alertes internes (survente notamment)
ADMIN_ALERT_EMAIL=''
